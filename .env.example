# API Keys for Agent Memory Service
# Copy this file to .env and fill in your actual keys

# OpenRouter API Key - Required for embeddings (qwen/qwen3-embedding-8b:nitro)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# LLM API Key - Required for LLM operations (any OpenAI-compatible provider)
# Default: Zhipu AI GLM-5 (https://open.bigmodel.cn/)
# Examples for other providers:
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
#   MiniMax: LLM_BASE_URL=https://api.minimax.io/v1  LLM_MODEL=MiniMax-M2.7
LLM_API_KEY=your-llm-api-key-here
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-5
